---
/** /book/ — the booking flow (app UI). Pricing CTAs link here as /book/?item=<slug>&tier=<slug>. */
import AppLayout from '../layouts/AppLayout.astro';
import BookingWidget from '../components/BookingWidget';
---

<AppLayout title="Book a truck and driver | BoxHauls">
  <div class="mx-auto max-w-xl">
    <h1 class="text-3xl md:text-4xl">Book a truck and driver</h1>
    <p class="mt-2 text-muted">Enter both addresses to see your price before you book.</p>
    <div class="mt-6">
      <BookingWidget client:idle source="book" />
    </div>
    <noscript>
      <p class="mt-4">Booking needs JavaScript. You can also book in the BoxHauls app.</p>
    </noscript>
  </div>
</AppLayout>
