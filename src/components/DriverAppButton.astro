---
/**
 * "Got a truck? Get paid to drive it": sits under "Download app now" and opens BoxHauls Driver at driver.boxhauls.com
 * with ?install=1, where the driver app's own install prompt pops up. (A phone installs an app only from that
 * app's own address, so the customer site can't install the driver app directly.)
 * Owner-approved exception to audience isolation (2026-10-15): this button may appear on rider pages.
 */
interface Props {
  variant?: 'primary' | 'outline' | 'light';
  class?: string;
}
const { variant = 'outline', class: className } = Astro.props;
const styles = {
  primary: 'bg-brand text-inverse hover:bg-brand-hover hover:text-inverse',
  outline: 'border-2 border-ink text-ink hover:bg-ink hover:text-inverse',
  light: 'border-2 border-inverse text-inverse hover:bg-inverse hover:text-ink',
};
---

<a href="https://driver.boxhauls.com/?install=1" class:list={['display inline-flex items-center justify-center gap-2 rounded-sm px-4 py-2.5 no-underline', styles[variant], className]}>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" /></svg>
  Got a truck? Get paid to drive it
</a>
