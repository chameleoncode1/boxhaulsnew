---
/**
 * Structured list of a hub's direct child pages (map Section 10: every hub links to every spoke).
 * An indexable page lists only indexable children, so launch pages never point at Phase-2/3 stubs.
 */
import { pages, type Page } from '../lib/sitemap';
import Text from './Text.astro';

interface Props {
  page: Page;
  heading?: string;
}
const { page, heading } = Astro.props;
const children = pages.filter(
  (p) => p.url !== page.url && p.url.replace(/[^/]+\/$/, '') === page.url && (!page.indexable || p.indexable),
);
---

{
  children.length > 0 && (
    <section data-block="children" class="mt-12">
      {heading && <h2 class="text-2xl">{heading}</h2>}
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {children.map((c) => (
          <li>
            <a href={c.url} class="card group flex h-full items-center justify-between gap-3 py-4 pr-4 pl-6 font-semibold">
              <span><Text text={c.h1} /></span>
              <span aria-hidden="true" class="text-brand transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
