---
/** Scaffold body: H1, the required content blocks, and the links_to list. Replaced by real layouts in Prompt 2. */
import type { Page } from '../lib/sitemap';
import { getPage } from '../lib/sitemap';
import Text from './Text.astro';

interface Props {
  page: Page;
}
const { page } = Astro.props;
---

<article class="max-w-prose">
  <p class="text-sm text-muted">
    Template: <code>{page.template}</code> · Phase {page.phase} · Cluster: {page.cluster}
  </p>
  <h1 class="mt-2 text-3xl font-bold"><Text text={page.h1} /></h1>
  <p class="mt-4 text-muted">Primary query: <Text text={page.primaryQuery} /></p>

  <h2 class="mt-8 text-xl font-semibold">Required content blocks</h2>
  <ul class="mt-3 list-disc space-y-1 pl-6">
    {page.contentBlocks.map((block) => <li><Text text={block} /></li>)}
  </ul>

  {
    page.linksTo.length > 0 && (
      <>
        <h2 class="mt-8 text-xl font-semibold">Links to</h2>
        <ul class="mt-3 list-disc space-y-1 pl-6">
          {page.linksTo.map((href) => {
            const target = getPage(href);
            return (
              <li>
                <a href={href}>{target ? <Text text={target.h1} /> : href}</a>
              </li>
            );
          })}
        </ul>
      </>
    )
  }
</article>
