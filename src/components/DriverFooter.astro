---
/** Driver footer: driver-section links only. Never links to /services/ (CLAUDE.md rule 7). */
import { getPage } from '../lib/sitemap';
import NapBlock from './NapBlock.astro';
import { year } from '../lib/site';

const links = [
  { url: '/drive/', label: 'Drive with BoxHauls' },
  { url: '/drive/requirements/', label: 'Requirements' },
  { url: '/drive/earnings/', label: 'Earnings' },
  { url: '/drive/how-payouts-work/', label: 'How payouts work' },
  { url: '/drive/safety/', label: 'Safety' },
  { url: '/drive/faq/', label: 'Driver FAQ' },
  { url: '/drive/apply/', label: 'Apply' },
  { url: '/contact/', label: 'Contact' },
];
for (const l of links) if (!getPage(l.url)) throw new Error(`Driver footer link ${l.url} is not in sitemap.json`);
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="mx-auto grid max-w-content gap-8 px-4 py-10 md:grid-cols-3">
    <nav aria-label="Footer" class="md:col-span-2">
      <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        {links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
      </ul>
    </nav>
    <NapBlock />
  </div>
  <div class="mx-auto flex max-w-content flex-wrap gap-4 border-t border-border px-4 py-4 text-sm text-muted">
    <span>© {year.value} BoxHauls</span>
    <a href="/legal/driver-agreement/" rel="nofollow">Driver agreement</a>
    <a href="/legal/terms/" rel="nofollow">Terms</a>
    <a href="/legal/privacy/" rel="nofollow">Privacy</a>
  </div>
</footer>
