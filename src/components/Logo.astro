---
/** Brand wordmark ("BoxHauls" + "PICK UP. DELIVER. DONE."), generated from assets/brand-src by `npm run brand`. */
interface Props {
  variant?: 'light' | 'dark';
  height?: number;
  class?: string;
  /** Footer logos are below the fold: lazy, so they don't compete with the headline font. */
  lazy?: boolean;
}
const { variant = 'light', height = 44, class: className, lazy = false } = Astro.props;
const name = variant === 'dark' ? 'wordmark-on-dark' : 'wordmark';
// Source crop is 1186×285.
const width = Math.round((height * 1186) / 285);
---

<picture class={className}>
  <source srcset={`/brand/${name}.webp`} type="image/webp" />
  <img src={`/brand/${name}.png`} alt="BoxHauls" width={width} height={height} decoding="async" loading={lazy ? 'lazy' : undefined} fetchpriority={lazy ? undefined : 'high'} />
</picture>
