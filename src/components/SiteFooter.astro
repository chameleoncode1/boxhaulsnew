---
/**
 * Rider footer (map Section 10): at most 12 links — five hubs, /pricing/, /trust/, /cities/, /guides/, /drive/,
 * /partners/, /contact/ — plus the NAP block and app badges. /drive/ appears here and nowhere else on rider pages.
 * Legal links sit in the small-print row with rel="nofollow" (sitemap: "indexable but no-follow in nav").
 */
import { getPage, pages } from '../lib/sitemap';
import { shortLabel } from '../lib/labels';
import NapBlock from './NapBlock.astro';
import AppBadges from './AppBadges.astro';
import Logo from './Logo.astro';
import FooterBand from './FooterBand.astro';
import { year } from '../lib/site';

const hubs = pages.filter((p) => p.template === 'service-hub');
const more = [
  { url: '/pricing/', label: 'Pricing' },
  { url: '/trust/', label: 'Trust & safety' },
  { url: '/cities/', label: 'Service area' },
  { url: '/guides/', label: 'Guides' },
  { url: '/drive/', label: 'Drive with BoxHauls' },
  { url: '/partners/', label: 'Partners' },
  { url: '/contact/', label: 'Contact' },
];
const links = [...hubs.map((h) => ({ url: h.url, label: shortLabel(h) })), ...more];
if (links.length > 12) throw new Error(`Footer has ${links.length} links; the limit is 12`);
for (const l of links) if (!getPage(l.url)) throw new Error(`Footer link ${l.url} is not in sitemap.json`);

const legal = pages.filter((p) => p.template === 'legal' && p.url !== '/legal/driver-agreement/');
const link = 'text-inverse no-underline hover:text-brand-on-night hover:underline';
---

<footer class="mt-16 bg-night text-night-muted">
  <FooterBand />
  <div class="mx-auto grid max-w-content gap-10 px-4 py-12 md:grid-cols-3">
    <div class="space-y-4">
      <Logo variant="dark" height={52} />
      <NapBlock tone="dark" />
    </div>
    <nav aria-label="Footer" class="md:col-span-2">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3">
        {links.map((l) => <li><a href={l.url} class={link}>{l.label}</a></li>)}
      </ul>
      <div class="mt-8"><AppBadges tone="dark" /></div>
    </nav>
  </div>
  <div class="border-t border-night-border">
    <div class="mx-auto flex max-w-content flex-wrap gap-4 px-4 py-4 text-sm">
      <span>© {year.value} BoxHauls</span>
      {legal.map((p) => <a href={p.url} rel="nofollow" class={link}>{shortLabel(p)}</a>)}
    </div>
  </div>
</footer>
