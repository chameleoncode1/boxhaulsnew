---
/** Desktop sidebar on rider pages: the price formula, trust facts and the two main actions. Sticky below the header. */
import { resolve } from '../lib/placeholders';
import Text from './Text.astro';
import InstallApp from './InstallApp.astro';
import DriverAppButton from './DriverAppButton.astro';

const facts = [
  resolve('{{BASE_FARE}} base + {{PER_MILE}} a mile').text,
  'No hourly rate, no surge',
  resolve('Insured by {{INSURANCE_CARRIER}}').text,
  resolve('Drivers screened by {{BACKGROUND_PROVIDER}}').text,
];
---

<aside class="price-aside sticky top-24 hidden lg:block" aria-label="Get a price">
  <div class="overflow-hidden rounded-md bg-night text-inverse">
    <div class="h-1.5 bg-brand"></div>
    <div class="p-6">
      <p class="display text-2xl">See your price</p>
      <p class="mt-1 text-sm text-night-muted">Shown before you book. Charged when the trip is done.</p>
      <ul class="mt-5 space-y-2.5 text-sm">
        {facts.map((f) => (
          <li class="flex gap-2.5"><svg class="mt-0.5 shrink-0" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" fill="none" stroke="var(--color-brand-on-night)" stroke-width="2.5" /></svg><span><Text text={f} /></span></li>
        ))}
      </ul>
      <a href="/book/" class="display mt-6 flex items-center justify-center rounded-sm bg-brand px-4 py-3 text-lg text-inverse no-underline hover:bg-brand-hover hover:text-inverse">Get a price</a>
      <InstallApp variant="light" class="mt-3 flex w-full py-3" />
      <DriverAppButton variant="light" class="mt-3 flex w-full py-3 text-sm" />
    </div>
  </div>
</aside>
