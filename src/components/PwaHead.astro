---
/**
 * PWA head tags, early service worker registration and install-prompt capture. Included in every layout.
 * Chrome/Edge/Samsung fire `beforeinstallprompt` only once a service worker is registered, so it registers
 * as soon as the head parses (not on window load) and the event is stashed for any "Download app now" button.
 */
import { tokenColor } from '../lib/theme';
const theme = tokenColor('night');
---

<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content={theme} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="BoxHauls" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
<script is:inline>
  (function () {
    var root = document.documentElement;
    window.__bhInstallPrompt = null;
    window.__bhPromptWaiters = [];
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      window.__bhInstallPrompt = e;
      root.dataset.installable = 'true';
      var waiters = window.__bhPromptWaiters.splice(0);
      waiters.forEach(function (fn) { fn(e); });
    });
    window.addEventListener('appinstalled', function () {
      window.__bhInstallPrompt = null;
      root.dataset.installed = 'true';
      try { localStorage.setItem('bh-installed', '1'); } catch (_) {}
    });
    var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    if (standalone) root.dataset.installed = 'true';
    var local = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
    if ('serviceWorker' in navigator && !local) {
      navigator.serviceWorker.register('/sw.js').catch(function () {});
    }
  })();
</script>
