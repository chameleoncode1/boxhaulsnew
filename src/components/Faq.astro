---
import Text from './Text.astro';
/**
 * FAQ block (map Section 9.7): question as H3 in the user's words, short answer. Mirrors FAQPage schema exactly.
 * Accordion via <details>: every answer is in the HTML (crawlable, works without JavaScript); the first is open.
 */
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<section id="faq" data-block="faq" class="mt-12">
  <h2 class="text-2xl md:text-3xl">Questions</h2>
  <div class="mt-5 space-y-3">
    {
      items.map((f, i) => (
        <details class="faq-item group rounded-md border border-border bg-bg open:border-border-strong" open={i === 0}>
          <summary class="flex cursor-pointer items-start justify-between gap-4 p-4 md:p-5">
            <h3 class="text-lg font-semibold"><Text text={f.question} /></h3>
            <span class="faq-icon mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand text-inverse" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2.4" /></svg>
            </span>
          </summary>
          <p class="max-w-prose px-4 pb-5 md:px-5"><Text text={f.answer} /></p>
        </details>
      ))
    }
  </div>
</section>
