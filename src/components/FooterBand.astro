---
/** Red / black slanted band across the top of the footer, after the banner's bottom strip. */
---

<div class="flex min-h-14 items-stretch text-inverse" aria-hidden="true">
  <div class="flex flex-1 items-center bg-brand px-4">
    <span class="display text-sm sm:text-lg">Book online or in the app</span>
  </div>
  <div class="slant-left flex items-center bg-night pr-4 pl-10 sm:pr-6 sm:pl-14">
    <span class="display text-sm sm:text-lg">boxhauls.com</span>
  </div>
</div>
