---
interface Props {
  appName?: string;
  icon?: string;
}
const { appName = 'BoxHauls', icon = '/brand/icon-192.png' } = Astro.props;
/**
 * Install flow for every [data-install-app] button ("Download app now"). Rendered once per page.
 * - Chrome / Edge / Samsung (Android, tablets, desktop): opens the browser's Install dialog. If the browser
 *   hasn't offered it yet (first seconds of a first visit), waits up to 4 s, still inside the tap's
 *   user-activation window, then opens it.
 * - iPhone / iPad: Apple allows no install prompt, so it shows Share → Add to Home Screen, pointing at where
 *   the Share button is in that browser.
 * - In-app browsers (Instagram, Facebook, TikTok…) can't install anything: explains how to open the page in a real browser.
 */
---

<dialog id="install-help" class="install-help m-auto w-[min(92vw,26rem)] rounded-md border-t-4 border-brand bg-bg p-0 text-ink">
  <div class="p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <img src={icon} alt="" width="48" height="48" class="h-12 w-12 rounded-xl bg-night" loading="lazy" />
        <h2 class="text-2xl leading-tight">Get the {appName} app</h2>
      </div>
      <form method="dialog"><button class="-mt-1 text-3xl leading-none text-muted hover:text-ink" aria-label="Close">×</button></form>
    </div>

    <div data-help="waiting" hidden>
      <p class="mt-4 flex items-center gap-3"><span class="install-spinner" aria-hidden="true"></span> Getting the app ready to install…</p>
    </div>

    <div data-help="ios" hidden>
      <p class="mt-4">Two taps and {appName} is on your home screen:</p>
      <ol class="mt-4 space-y-4">
        <li class="flex gap-3"><span class="step-dot">1</span><span>Tap <strong>Share</strong> <svg aria-label="Share icon" class="inline -mt-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15V3m0 0L8 7m4-4l4 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg> <span data-ios-where></span></span></li>
        <li class="flex gap-3"><span class="step-dot">2</span><span>Scroll down and tap <strong>Add to Home Screen</strong>, then <strong>Add</strong>.</span></li>
      </ol>
      <p class="mt-4 text-sm text-muted">Don't see Add to Home Screen? Tap <strong>Edit Actions</strong> at the bottom of the Share menu and add it.</p>
    </div>

    <div data-help="inapp" hidden>
      <p class="mt-4">This page is open inside another app, which can't install {appName}.</p>
      <ol class="mt-4 space-y-4">
        <li class="flex gap-3"><span class="step-dot">1</span><span>Tap the <strong>⋯</strong> or <strong>⋮</strong> menu in the corner.</span></li>
        <li class="flex gap-3"><span class="step-dot">2</span><span>Choose <strong>Open in browser</strong> (or Open in Safari / Chrome), then tap <strong>Download app now</strong> again.</span></li>
      </ol>
      <button type="button" data-copy-link class="display mt-5 w-full rounded-sm border-2 border-ink px-4 py-2.5">Copy link</button>
    </div>

    <div data-help="other" hidden>
      <p class="mt-4">Your browser didn't offer one-tap install this time (this happens after an install is dismissed, or in some browsers).</p>
      <ol class="mt-4 space-y-4">
        <li class="flex gap-3"><span class="step-dot">1</span><span data-other-step1>Open your browser's menu (<strong>⋮</strong> or <strong>⋯</strong>).</span></li>
        <li class="flex gap-3"><span class="step-dot">2</span><span>Tap <strong>Install app</strong> or <strong>Add to Home screen</strong>.</span></li>
      </ol>
    </div>

    <div data-help="installed" hidden>
      <p class="mt-4">{appName} is installed on this device. Open it from your home screen or app list.</p>
    </div>

    <div data-help="done" hidden>
      <p class="mt-4"><strong>Installing now.</strong> {appName} will appear on your home screen in a moment.</p>
    </div>
  </div>
</dialog>
<script is:inline>
  (function () {
    var dialog = document.getElementById('install-help');
    var ua = navigator.userAgent;
    var root = document.documentElement;
    var isAndroid = /android/i.test(ua);
    // iPadOS reports itself as a Mac; a touch screen gives it away.
    var isIOS = !isAndroid && (/iphone|ipad|ipod/i.test(ua) || (/macintosh/i.test(ua) && navigator.maxTouchPoints > 1));
    var isInApp = /FBAN|FBAV|Instagram|Line\/|Snapchat|TikTok|musical_ly|Twitter|LinkedInApp|GSA\//i.test(ua);
    var isFirefox = /firefox|fxios/i.test(ua);

    function show(kind) {
      dialog.querySelectorAll('[data-help]').forEach(function (el) { el.hidden = el.getAttribute('data-help') !== kind; });
      if (!dialog.open && dialog.showModal) dialog.showModal();
    }
    function close() { if (dialog.open) dialog.close(); }

    function iosWhere() {
      var ipad = /ipad/i.test(ua) || /macintosh/i.test(ua);
      if (/CriOS|EdgiOS/i.test(ua)) return 'at the top right, next to the address bar.';
      if (/FxiOS/i.test(ua)) return 'in the ⋯ menu at the bottom right.';
      return ipad ? 'at the top right of Safari.' : 'in the toolbar at the bottom of Safari (tap the address bar first if it’s hidden).';
    }

    function runPrompt(prompt) {
      close();
      window.__bhInstallPrompt = null;
      prompt.prompt();
      prompt.userChoice.then(function (choice) {
        if (choice && choice.outcome === 'accepted') show('done');
      });
    }

    function otherHelp() {
      var step = dialog.querySelector('[data-other-step1]');
      if (isFirefox && isAndroid) step.innerHTML = 'Tap the <strong>⋮</strong> menu in Firefox.';
      else if (!isAndroid && /edg\//i.test(ua)) step.innerHTML = 'Click <strong>⋯</strong> → <strong>Apps</strong> in Edge.';
      else if (!isAndroid && /chrome/i.test(ua)) step.innerHTML = 'Click the install icon in the address bar, or <strong>⋮</strong> → <strong>Cast, save and share</strong>.';
      show('other');
    }

    dialog.querySelector('[data-copy-link]').addEventListener('click', function (e) {
      var btn = e.currentTarget;
      navigator.clipboard && navigator.clipboard.writeText(location.origin + '/').then(function () { btn.textContent = 'Link copied'; });
    });

    document.addEventListener('click', function (e) {
      var btn = e.target instanceof Element ? e.target.closest('[data-install-app]') : null;
      if (!btn) return;
      e.preventDefault();
      if (root.dataset.installed === 'true') return show('installed');
      if (window.__bhInstallPrompt) return runPrompt(window.__bhInstallPrompt);
      if (isInApp) return show('inapp');
      if (isIOS) {
        dialog.querySelector('[data-ios-where]').textContent = iosWhere();
        return show('ios');
      }
      // Chromium browsers fire the prompt a moment after the service worker is ready: wait for it briefly.
      if ('serviceWorker' in navigator && 'BeforeInstallPromptEvent' in window) {
        show('waiting');
        var settled = false;
        var timer = setTimeout(function () {
          if (settled) return;
          settled = true;
          otherHelp();
        }, 4000);
        window.__bhPromptWaiters.push(function (prompt) {
          if (settled) return;
          settled = true;
          clearTimeout(timer);
          runPrompt(prompt);
        });
        return;
      }
      otherHelp();
    });

    // Opened from a "?install=1" link (e.g. a text or QR code): offer the install right away.
    if (/[?&]install=1\b/.test(location.search) && isIOS && root.dataset.installed !== 'true') {
      dialog.querySelector('[data-ios-where]').textContent = iosWhere();
      show('ios');
    }
  })();
</script>
