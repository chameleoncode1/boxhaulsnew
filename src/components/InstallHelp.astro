---
/** Install-help dialog + click handling for every [data-install-app] button. Rendered once per page. */
---

<dialog id="install-help" class="install-help m-auto w-[min(92vw,26rem)] rounded-sm border-t-4 border-brand bg-bg p-0 text-ink">
  <div class="p-6">
    <div class="flex items-start justify-between gap-4">
      <h2 class="text-2xl">Get the BoxHauls app</h2>
      <form method="dialog"><button class="text-2xl leading-none text-muted" aria-label="Close">×</button></form>
    </div>
    <div data-help="ios" hidden>
      <p class="mt-3">Add BoxHauls to your home screen in two taps:</p>
      <ol class="mt-3 space-y-3">
        <li class="flex gap-3"><span class="display flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand text-sm text-inverse">1</span><span>Tap the <strong>Share</strong> button <svg aria-label="Share icon" class="inline" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15V3m0 0L8 7m4-4l4 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg> in Safari's toolbar.</span></li>
        <li class="flex gap-3"><span class="display flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand text-sm text-inverse">2</span><span>Choose <strong>Add to Home Screen</strong>, then <strong>Add</strong>.</span></li>
      </ol>
      <p class="mt-3 text-sm text-muted">On iPhone and iPad this works in Safari. In other browsers, open boxhauls.com in Safari first.</p>
    </div>
    <div data-help="other" hidden>
      <p class="mt-3">Open your browser's menu (<strong>⋮</strong> or <strong>…</strong>) and choose <strong>Install app</strong> or <strong>Add to Home screen</strong>.</p>
    </div>
    <div data-help="installed" hidden>
      <p class="mt-3">BoxHauls is already installed on this device. Open it from your home screen.</p>
    </div>
  </div>
</dialog>
<script is:inline>
  (function () {
    var dialog = document.getElementById('install-help');
    function isIOS() {
      var ua = navigator.userAgent;
      if (/android/i.test(ua)) return false;
      // iPadOS reports itself as a Mac; a touch screen gives it away.
      return /iphone|ipad|ipod/i.test(ua) || (/macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
    }
    function show(kind) {
      dialog.querySelectorAll('[data-help]').forEach(function (el) { el.hidden = el.getAttribute('data-help') !== kind; });
      if (dialog.showModal) dialog.showModal();
    }
    document.addEventListener('click', function (e) {
      var btn = e.target instanceof Element ? e.target.closest('[data-install-app]') : null;
      if (!btn) return;
      e.preventDefault();
      if (document.documentElement.dataset.installed === 'true') return show('installed');
      var prompt = window.__bhInstallPrompt;
      if (prompt) {
        prompt.prompt();
        prompt.userChoice.finally(function () { window.__bhInstallPrompt = null; });
        return;
      }
      show(isIOS() ? 'ios' : 'other');
    });
  })();
</script>
