---
/** NAP — the identical string on /contact/, the footer, GBP and every citation (map Section 1.1). */
import Text from './Text.astro';
import { email, napParts, phoneE164 } from '../lib/site';

const [name, address, phone] = napParts;
const tel = phoneE164();
const show = (f: { key: string; value?: string }) => f.value ?? `[TODO: ${f.key}]`;
---

<address class="not-italic">
  <strong><Text text={show(name)} /></strong><br />
  <Text text={show(address)} /><br />
  {tel ? <a href={`tel:${tel}`}>{phone.value}</a> : <Text text={show(phone)} />}
  {email.value && (<><br /><a href={`mailto:${email.value}`}>{email.value}</a></>)}
</address>
