---
/** 3–5 related pages from the same cluster, chosen for this page. Never sitewide, never the homepage. */
import type { Page } from '../lib/sitemap';
import { relatedLinks } from '../lib/links';
import Text from './Text.astro';

interface Props {
  page: Page;
}
const related = relatedLinks(Astro.props.page);
---

{
  related.length > 0 && (
    <aside aria-labelledby="related-heading" class="mt-12 border-t border-border pt-6">
      <h2 id="related-heading" class="text-lg font-semibold">Related</h2>
      <ul class="mt-3 space-y-2">
        {related.map((p) => <li><a href={p.url}><Text text={p.h1} /></a></li>)}
      </ul>
    </aside>
  )
}
