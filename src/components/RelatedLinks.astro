---
/** 3–5 related pages from the same cluster, chosen for this page. Never sitewide, never the homepage. */
import type { Page } from '../lib/sitemap';
import { relatedLinks } from '../lib/links';
import Text from './Text.astro';

interface Props {
  page: Page;
}
const related = relatedLinks(Astro.props.page);
---

{
  related.length > 0 && (
    <aside aria-labelledby="related-heading" class="mt-14 border-t border-border pt-8">
      <h2 id="related-heading" class="text-2xl">Related</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => (
          <li>
            <a href={p.url} class="card group flex h-full items-center justify-between gap-3 py-4 pr-4 pl-6 font-semibold">
              <span><Text text={p.h1} /></span>
              <span aria-hidden="true" class="text-brand transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
