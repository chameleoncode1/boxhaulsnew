---
/** Honest empty state for data that does not exist yet (reviews, driver profiles, partner logos, trip prices). */
interface Props {
  title: string;
  message: string;
}
const { title, message } = Astro.props;
---

<div class="rounded-md border border-border bg-surface p-6">
  <p class="font-semibold">{title}</p>
  <p class="mt-1 text-sm text-muted">{message}</p>
</div>
