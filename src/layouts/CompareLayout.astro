---
/** Compare page (map Section 7): eight criteria in fixed order, honest about where the competitor wins, facts dated. */
import type { Page } from '../lib/sitemap';
import type { PageContent } from '../lib/schema';
import BaseLayout from './BaseLayout.astro';
import Written from '../components/Written.astro';
import PageTitle from '../components/PageTitle.astro';
import Byline from '../components/Byline.astro';
import Block from '../components/Block.astro';
import ChildList from '../components/ChildList.astro';
import BodyLinks from '../components/BodyLinks.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import PageSpec from '../components/PageSpec.astro';

interface Props {
  page: Page;
  content?: PageContent;
  /** Rendered MDX body from src/content/pages/, when the page has been written. */
  Body?: any;
}
const { page, content = {}, Body } = Astro.props;
const isIndex = page.url === '/compare/';
---

<BaseLayout page={page} content={content}>
  <PageTitle page={page} />
  <Byline kind="reviewed" checked={content.checked} checkedLabel="Facts checked" />
  {Body && <Written Body={Body} content={content} />}
  {
    isIndex ? (
      <>
        {!Body && (<Block id="verdicts" label="One-line verdict per comparison"><slot name="verdicts" /></Block>)}
        {!Body && (<Block id="master-table" label="Master comparison table"><slot name="master-table" /></Block>)}
        <ChildList page={page} />
      </>
    ) : (
      <>
        {!Body && (<Block id="verdict" label="Short verdict (answers the primary query)"><slot name="verdict" /></Block>)}
        {!Body && (<Block id="criteria" label="Criteria table: price model, minimum, Fresno coverage, insurance, vetting, scheduling, helpers, app"><slot name="criteria" /></Block>)}
        {!Body && (<Block id="where-each-wins" label="Where each wins (including where the competitor wins)"><slot name="where-each-wins" /></Block>)}
        {!Body && (<Block id="use-cases" label="Verdict by use case"><slot name="use-cases" /></Block>)}
        {!Body && (<Block id="sources" label="Sources, with dates"><slot name="sources" /></Block>)}
        {!Body && page.schema.includes('FAQPage') && <Block id="faq" label="FAQ (mirrored in FAQPage schema)"><slot name="faq" /></Block>}
      </>
    )
  }
  {!Body && <BodyLinks page={page} />}
  <RelatedLinks page={page} />
  {!Body && <PageSpec page={page} />}
</BaseLayout>
