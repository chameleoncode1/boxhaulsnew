---
import '../styles/global.css';
import type { Page } from '../lib/sitemap';
import { metaTitle } from '../lib/labels';
import { buildGraph, type PageContent } from '../lib/schema';
import { SITE_URL } from '../lib/site';
import { ogImagePath, OG_WIDTH, OG_HEIGHT } from '../lib/og';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DriverHeader from '../components/DriverHeader.astro';
import DriverFooter from '../components/DriverFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Analytics from '../components/Analytics.astro';
import PwaHead from '../components/PwaHead.astro';
import InstallHelp from '../components/InstallHelp.astro';
import CookieConsent from '../components/CookieConsent.astro';
import CtaBand from '../components/CtaBand.astro';
import MobileBar from '../components/MobileBar.astro';
import PriceAside from '../components/PriceAside.astro';
import { alternates, langOf } from '../lib/i18n';
// The H1 is the LCP element on most pages; fetch its font with the HTML instead of after the CSS.
import sairaDisplay from '@fontsource/saira/files/saira-latin-800-italic.woff2?url';

interface Props {
  page: Page;
  content?: PageContent;
}
const { page, content = {} } = Astro.props;

const canonical = new URL(page.url, SITE_URL).href;
const title = metaTitle(page);
const description = content.description;
const ogImage = new URL(ogImagePath(page), SITE_URL).href;
const { graph } = buildGraph(page, content);
const driver = page.audience === 'driver';
const hreflang = alternates(page);
// Rider inner pages get the sticky price card beside the copy on wide screens.
const aside = !driver && page.template !== 'home' && page.template !== 'legal';
---

<!doctype html>
<html lang={langOf(page.url)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={sairaDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png?v=3" />
    <PwaHead />
    {!page.indexable && <meta name="robots" content="noindex" />}
    {hreflang.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content={page.template === 'guide' ? 'article' : 'website'} />
    <meta property="og:site_name" content="BoxHauls" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={page.h1} />
    <meta name="twitter:card" content="summary_large_image" />

    <Analytics />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  </head>
  <body class:list={['bg-bg text-ink', !driver && 'pb-20 lg:pb-0']} data-template={page.template} data-audience={page.audience} data-phase={page.phase}>
    {driver ? <DriverHeader /> : <SiteHeader />}
    <main>
      <slot name="full-hero" />
      {
        Astro.slots.has('hero') && (
          <section data-block="page-hero" class="page-hero relative overflow-hidden border-b border-border bg-surface">
            <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[22%] md:flex" aria-hidden="true">
              <div class="slant-left w-1/2 bg-brand" />
              <div class="slant-left -ml-6 w-1/2 bg-night" />
            </div>
            <div class="relative mx-auto max-w-content px-4 pt-6 pb-8 md:pt-8 md:pb-12">
              <div class="md:max-w-[74%]">
                <Breadcrumbs page={page} />
                <slot name="hero" />
                <span class="mt-5 block h-1 w-16 bg-brand md:hidden" aria-hidden="true" />
              </div>
            </div>
          </section>
        )
      }
      <div class:list={['mx-auto max-w-content px-4 py-8 md:py-10', aside && 'lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start lg:gap-12']}>
        <div class="min-w-0">
          {!Astro.slots.has('hero') && <Breadcrumbs page={page} />}
          <slot />
        </div>
        {aside && <PriceAside />}
      </div>
    </main>
    {!driver && <CtaBand />}
    {driver ? <DriverFooter /> : <SiteFooter />}
    {!driver && <MobileBar />}
    <InstallHelp />
    <CookieConsent />
  </body>
</html>
