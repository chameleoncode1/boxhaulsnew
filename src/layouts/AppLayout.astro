---
/**
 * Layout for app UI that isn't a marketing page (/book/). Not in docs/sitemap.json by design (map Section 12:
 * "booking flow is app UI, not a landing page"): noindex, no JSON-LD, excluded from sitemap.xml, disallowed in
 * robots.txt, X-Robots-Tag noindex in _headers.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '../components/Analytics.astro';
import sairaDisplay from '@fontsource/saira/files/saira-latin-800-italic.woff2?url';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href={sairaDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <Analytics />
  </head>
  <body class="bg-bg text-ink" data-template="app">
    <SiteHeader />
    <main class="mx-auto max-w-content px-4 py-8">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
