---
/** Guide (map Section 8). Driver guides under /drive/guides/ use this template with driver chrome (BaseLayout picks it). */
import type { Page } from '../lib/sitemap';
import type { PageContent } from '../lib/schema';
import BaseLayout from './BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import Byline from '../components/Byline.astro';
import Block from '../components/Block.astro';
import ChildList from '../components/ChildList.astro';
import BodyLinks from '../components/BodyLinks.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import PageSpec from '../components/PageSpec.astro';

interface Props {
  page: Page;
  content?: PageContent;
}
const { page, content } = Astro.props;
const has = (t: string) => page.schema.includes(t);
const isIndex = page.url === '/guides/';
---

<BaseLayout page={page} content={content}>
  <PageTitle page={page} />
  {!isIndex && <Byline kind="guide" checked={false} />}
  {
    isIndex ? (
      <>
        <Block id="intro" label="Index intro"><slot name="intro" /></Block>
        <ChildList page={page} />
      </>
    ) : (
      <>
        <Block id="answer" label="Answer in sentence one"><slot name="answer" /></Block>
        {has('HowTo') && <Block id="steps" label="Steps (mirrored in HowTo schema)"><slot name="steps" /></Block>}
        <Block id="body" label="Guide body: tables, real photos, one descriptive link into the core page"><slot /></Block>
        {has('FAQPage') && <Block id="faq" label="FAQ (mirrored in FAQPage schema)"><slot name="faq" /></Block>}
      </>
    )
  }
  <BodyLinks page={page} />
  <RelatedLinks page={page} />
  <PageSpec page={page} />
</BaseLayout>
