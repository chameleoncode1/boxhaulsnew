---
import type { Page } from '../lib/sitemap';
import type { PageContent } from '../lib/schema';
import { pages } from '../lib/sitemap';
import { shortLabel } from '../lib/labels';
import BaseLayout from './BaseLayout.astro';
import Written from '../components/Written.astro';
import Text from '../components/Text.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import BookingWidget from '../components/BookingWidget';
import Block from '../components/Block.astro';
import TrustBadges from '../components/TrustBadges.astro';
import EmptyState from '../components/EmptyState.astro';
import AppBadges from '../components/AppBadges.astro';
import BodyLinks from '../components/BodyLinks.astro';
import PageSpec from '../components/PageSpec.astro';

interface Props {
  page: Page;
  content?: PageContent;
  /** Rendered MDX body from src/content/pages/, when the page has been written. */
  Body?: any;
}
const { page, content = {}, Body } = Astro.props;
const hubs = pages.filter((p) => p.template === 'service-hub');
// Banner style: the H1's first sentence in ink, the rest in brand red.
const [lead, ...rest] = page.h1.split(/(?<=\.)\s+/);
const tail = rest.join(' ');
---

<BaseLayout page={page} content={content}>
  <section data-block="hero" class="grid items-center gap-8 md:grid-cols-[1.1fr_1fr]">
    <div>
      <h1 class="mt-4 text-4xl md:text-5xl"><Text text={lead} />{tail && <><br /><span class="text-brand"><Text text={tail} /></span></>}</h1>
      <p class="tagline mt-6 text-sm text-ink">
        <span>Pick up. <span class="text-brand">Deliver.</span> Done.</span>
      </p>
    </div>
    <div class="relative pr-3 pb-3">
      <div class="slant-left absolute top-3 right-0 bottom-0 left-3 bg-brand" aria-hidden="true"></div>
      <div class="relative">
        <!-- Booking widget above the fold (map Section 4). No price until both addresses are entered. -->
        <BookingWidget client:idle source="home" />
      </div>
    </div>
  </section>
  {Body && <Written Body={Body} content={content} />}
  {!Body && (<Block id="launch-metro" label="One-line launch-metro statement"><slot name="launch-metro" /></Block>)}
  <section data-block="trust" class="mt-10"><TrustBadges /></section>
  <section data-block="photo" class="mt-10"><slot name="hero-photo"><PhotoPlaceholder description="a BoxHauls driver loading a customer's item into a pickup in Fresno" width={1200} height={500} /></slot></section>
  {!Body && (<Block id="how-it-works" label="3-step how it works"><slot name="how-it-works" /></Block>)}
  <section data-block="services" class="mt-10">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {hubs.map((h) => (
        <li class="border-l-4 border-brand bg-surface p-4">
          <a href={h.url} class="display text-lg text-ink no-underline hover:text-brand">{shortLabel(h)}</a>
        </li>
      ))}
    </ul>
  </section>
  <section data-block="reviews" class="mt-10">
    <EmptyState title="Reviews" message="Reviews from Google will show here once customers leave them." />
  </section>
  <section data-block="app" class="mt-10"><AppBadges /></section>
  {!Body && <BodyLinks page={page} />}
  {!Body && <PageSpec page={page} />}
</BaseLayout>
