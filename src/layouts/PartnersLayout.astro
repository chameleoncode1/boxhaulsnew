---
/** Partner pages. May link to /pricing/ and /trust/. Real partner logos only; no reciprocal-link or badge language. */
import type { Page } from '../lib/sitemap';
import type { PageContent } from '../lib/schema';
import BaseLayout from './BaseLayout.astro';
import Written from '../components/Written.astro';
import PageTitle from '../components/PageTitle.astro';
import Block from '../components/Block.astro';
import EmptyState from '../components/EmptyState.astro';
import Cta from '../components/Cta.astro';
import ChildList from '../components/ChildList.astro';
import BodyLinks from '../components/BodyLinks.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import PageSpec from '../components/PageSpec.astro';

interface Props {
  page: Page;
  content?: PageContent;
  /** Rendered MDX body from src/content/pages/, when the page has been written. */
  Body?: any;
}
const { page, content = {}, Body } = Astro.props;
const showLogos = page.url === '/partners/' || page.url === '/partners/directory/';
---

<BaseLayout page={page} content={content}>
  <PageTitle page={page} />
  {Body && <Written Body={Body} content={content} />}
  {!Body && (<Block id="answer" label="Answer-first opening"><slot name="answer" /></Block>)}
  {!Body && (<Block id="checkout-flow" label="How it works at checkout and what the customer pays"><slot name="checkout-flow" /></Block>)}
  {!Body && (<Block id="body" label="Page body (see the sitemap spec below)"><slot /></Block>)}
  {showLogos && <section data-block="partners" class="mt-10"><EmptyState title="Partners" message="Partner businesses will be listed here once they join." /></section>}
  <ChildList page={page} />
  {!Body && page.schema.includes('FAQPage') && <Block id="faq" label="FAQ (mirrored in FAQPage schema)"><slot name="faq" /></Block>}
  {page.url !== '/partners/apply/' && <section data-block="apply-cta" class="mt-10"><Cta href="/partners/apply/" label="Become a partner" /></section>}
  {!Body && <BodyLinks page={page} />}
  <RelatedLinks page={page} />
  {!Body && <PageSpec page={page} />}
</BaseLayout>
