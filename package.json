{
  "name": "boxhauls",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/cloudflare.mjs && node scripts/todo.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "map": "python3 build_map.py",
    "qa": "node scripts/qa.mjs",
    "links": "node scripts/links.mjs",
    "todo": "node scripts/todo.mjs",
    "brand": "node scripts/brand-assets.mjs",
    "lighthouse": "lhci autorun",
    "deploy": "npm run qa && wrangler pages deploy dist --project-name boxhaulsnew --branch main --commit-hash $(git rev-parse HEAD) --commit-message \"$(git log -1 --format=%s)\"",
    "bookings": "wrangler d1 execute boxhauls-bookings --remote --command \"SELECT id, created_at, status, driver_id, when_type, scheduled_date, scheduled_window, name, phone, item, miles, price_cents, customer_sms_status FROM bookings ORDER BY created_at DESC LIMIT 25\"",
    "check:functions": "tsc -p functions/tsconfig.json && tsc -p workers/dispatch-cron/tsconfig.json",
    "deploy:cron": "wrangler deploy --config workers/dispatch-cron/wrangler.toml",
    "drivers": "node scripts/drivers.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@fontsource/saira": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@fontsource/inter": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "satori": "^0.35.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  }
}
